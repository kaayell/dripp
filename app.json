{
  "expo": {
    "name": "dripp",
    "slug": "dripp",
    "version": "1.0.0",
    "scheme": "dripp",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18171b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kaayell.dripp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18171b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00b7c1"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/GeistMono-Regular.ttf",
            "./assets/fonts/GeistMono-Medium.ttf",
            "./assets/fonts/GeistMono-SemiBold.ttf",
            "./assets/fonts/GeistMono-Bold.ttf"
          ],
          "widgets": [
            {
              "name": "QuickLog",
              "label": "Quick log",
              "description": "Log today's tasks with a tap",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Geist-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Geist-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Geist-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Geist-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Geist Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GeistMono-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/GeistMono-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/GeistMono-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/GeistMono-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Geist-Regular.ttf",
              "./assets/fonts/Geist-Medium.ttf",
              "./assets/fonts/Geist-SemiBold.ttf",
              "./assets/fonts/Geist-Bold.ttf",
              "./assets/fonts/GeistMono-Regular.ttf",
              "./assets/fonts/GeistMono-Medium.ttf",
              "./assets/fonts/GeistMono-SemiBold.ttf",
              "./assets/fonts/GeistMono-Bold.ttf"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1cf8ed43-5628-4d06-a589-a00737a2da3f"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kaayell.dripp"
    }
  }
}
